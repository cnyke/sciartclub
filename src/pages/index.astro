---
import Layout from "../layouts/Layout.astro";
import haeckel from "../data/haeckel.json";
---

<Layout
    title="Sci Art Club"
    description="Sci Art Club: a community for people who make art about science, and science that looks like art."
>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Header -->
        <div class="text-center mb-12">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
                <span class="font-majormono font-normal">sci ARt club</span>
            </h1>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
                <span class="font-majormono">sci ARt club</span> is a community for
                people who make art about science, and science that looks like art.
                Whether you draw specimens, print from microscope slides, sew
                orbital mechanics, or just love a good anatomical plate, come hang out.
            </p>
        </div>

        <!-- Haeckel slider -->
        <div class="mb-12">
            <div class="haeckel-slider overflow-hidden">
                <div class="haeckel-track flex gap-4 w-max px-3">
                    {[...haeckel, ...haeckel].map((h, i) => (
                        <a href={h.link} target="_blank" rel="noopener noreferrer" class="haeckel-plate block shrink-0 rounded-md overflow-hidden" title={`${h.name} (Wikimedia Commons)`} aria-hidden={i >= haeckel.length ? "true" : undefined} tabindex={i >= haeckel.length ? -1 : undefined}>
                            <img src={h.src} alt={i < haeckel.length ? `Ernst Haeckel, ${h.name}, a plate from Kunstformen der Natur` : ""} class="h-72 md:h-96 w-auto" />
                        </a>
                    ))}
                </div>
            </div>
            <p class="text-sm text-gray-500 leading-relaxed mt-3 text-center max-w-3xl mx-auto">
                Plates by <a href="https://en.wikipedia.org/wiki/Ernst_Haeckel" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">Ernst Haeckel</a>, from <a href="https://en.wikipedia.org/wiki/Kunstformen_der_Natur" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline"><em>Kunstformen der Natur</em></a> (Art Forms in Nature, 1899 to 1904): radiolarians, jellyfish, diatoms, mosses, bats, and hummingbirds, drawn from the microscope and the field. Public domain; images via <a href="https://commons.wikimedia.org/wiki/Category:Kunstformen_der_Natur" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">Wikimedia Commons</a>. Hover to pause, click any plate for its source.
            </p>
        </div>

        <style>
            .haeckel-slider {
                -webkit-mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
                        mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
                padding: 0.75rem 0;
            }
            .haeckel-track { animation: haeckel-slide 300s linear infinite; }
            .haeckel-slider:hover .haeckel-track { animation-play-state: paused; }
            .haeckel-plate {
                transition: transform 500ms ease, box-shadow 500ms ease, filter 500ms ease;
                box-shadow: 0 0 0 rgba(255, 255, 255, 0);
                filter: saturate(1.08);
            }
            .haeckel-plate:hover {
                transform: scale(1.03);
                box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
                filter: saturate(1.25) brightness(1.05);
            }
            @keyframes haeckel-slide {
                from { transform: translateX(0); }
                to { transform: translateX(-50%); }
            }
            @media (prefers-reduced-motion: reduce) {
                .haeckel-track { animation: none; }
                .haeckel-slider { overflow-x: auto; }
            }
        </style>

        <!-- About Section -->
        <div class="max-w-4xl mx-auto mb-12">
            <p class="text-lg text-gray-600 leading-relaxed mb-6">
                We meet to look closely and make things:
            </p>
            <ul class="space-y-3 text-gray-600 mb-6">
                <li class="flex items-start gap-2">
                    <span class="mt-1 text-gray-400">&#x25B8;</span>
                    <span><strong class="text-gray-900">Talks:</strong> Hear from
                        scientists and artists about how they see, and how they
                        show what they see.</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-1 text-gray-400">&#x25B8;</span>
                    <span><strong class="text-gray-900">Workshops:</strong> Hands-on
                        sessions in scientific illustration, printmaking, field
                        sketching, and whatever else we can get our hands on.</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-1 text-gray-400">&#x25B8;</span>
                    <span><strong class="text-gray-900">Studio sessions:</strong>
                        Bring a project and work alongside others turning
                        specimens, data, and ideas into art.</span>
                </li>
            </ul>
        </div>

        <!-- TODO: Instagram / Meetup links once the accounts exist -->
    </div>
</Layout>
